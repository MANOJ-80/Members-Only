<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Home</title>
</head>
<body>
  <h1>Members Only !</h1>


<%  if(user) { %>
  <div>

    <h1>Welcome back <%= user.username %></h1>
    <h2>Role : <%= user.role%></h2>
    <div style="display: flex; gap: 50px;">
      <a href="/addpost">Add new Post</a>
      <% if (!(user.role === 'admin' || user.role === 'member')) {%>
        <a href="/member">Become a Member</a>  
      <% } %>
      <a href="/auth/log-out">LOG OUT</a> 

  
    </div>

    <%-include('posts', { posts: posts , role: user.role }) %>
  </div>
 
<% } else { %>
  <h2>Role : Guest</h2>
   <a href="auth/log-in">login</a>
   <br><br>
<a href="auth/sign-up">sign-up</a>
<% } %>
 
</body>
</html>