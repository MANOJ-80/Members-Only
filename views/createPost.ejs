<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Create Post</title>
</head>
<body>
  <h1>create post</h1>
  <form action="/addpost" method="POST">
    <label>Title</label>
    <input id="" name="title" placeholder="Title" type="text" />
    <label>Content</label>
    <textarea name="content" id="" placeholder="Type your post message here..."></textarea>
    <button type="submit">POST</button>
  </form>
</body>
</html>
