

<div>
    <% if(posts) { %>
       <% posts.forEach(post => { %>
            <div>
                <h2><%= post.title %></h2>
                <p><%= post.content %></p>

               
                <% if(role === 'admin' || role === 'member') {%>
                <p>Author: <%= post.author_id %></p>
                <p>Date: <%= post.created_at %></p>
                <% } %>

                <% if(role === 'admin') {%>
                    <form action="/delpost/<%= post.id %>" method="POST">
                        <button type="submit">Delete</button>
                    </form>
               <% } %>
            </div>
            <hr>
        <% }) %>
   <% } else { %>
        <h2>No posts available</h2>
   <% }%>
</div>