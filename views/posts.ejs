

<div>
    <% if(posts) { %>
       <% posts.forEach(post => { %>
            <div>
                <h2><%= post.title %></h2>
                <p><%= post.content %></p>
                <p>Author: <%= post.author_id %></p>
                <p>Date: <%= post.created_at %></p>
            </div>
        <% }) %>
   <% } else { %>
        <h2>No posts available</h2>
   <% }%>
</div>